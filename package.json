{
  "name": "scopedelta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:offline-windows": "tauri build --config src-tauri/tauri.offline-webview2.conf.json",
    "desktop:web:dev": "vite --config vite.desktop.config.ts",
    "desktop:web:build": "vite build --config vite.desktop.config.ts",
    "desktop:rust:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:rust:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ga": "vitest run --config vitest.ga.config.ts",
    "test:e2e": "playwright test",
    "ai:eval": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-eval.ts",
    "billing:economics": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/billing-economics.ts",
    "operations:signals": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/operations-signals.ts",
    "lifecycle:process": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/lifecycle-process.ts",
    "operations:alerts": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/operations-alerts.ts",
    "production:validate": "node --env-file-if-exists=.env.local --import tsx scripts/validate-production-config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^27.0.0",
    "jszip": "^3.10.1",
    "netlify-cli": "27.1.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
